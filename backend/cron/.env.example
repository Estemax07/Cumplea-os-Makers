# URL del backend de personas ya deployado (no localhost en producción)
BACKEND_URL=https://tu-backend.onrender.com

# --- Resend (https://resend.com) ---
# 1. Verificá tu dominio en Resend (Domains -> Add Domain, agregás los
#    registros DNS que te piden). Sin esto, Resend igual funciona pero
#    con su remitente de pruebas (onboarding@resend.dev), que puede caer
#    en spam más seguido.
# 2. Generá una API key en Resend (API Keys -> Create API Key).
RESEND_API_KEY=re_xxx
RESEND_FROM=Makers <cumples@tudominio.com>

# Quiénes reciben el aviso (separados por coma)
DESTINATARIOS=grupo-makers@tudominio.com

# URL pública del frontend deployado, para armar la URL de la imagen
# the_day_befo_pose.png (que vive en frontend/public/character/).
FRONTEND_URL=https://tu-frontend.vercel.app

# Alternativa: si preferís apuntar directo a una URL de imagen (por ejemplo
# alojada en el propio bucket de fotos o en GitHub raw), usá esta variable
# y dejá FRONTEND_URL vacío.
# THE_DAY_BEFORE_IMAGE_URL=https://.../the_day_befo_pose.png
