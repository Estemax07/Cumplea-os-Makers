# --- Base de datos ---
# Por defecto usa SQLite en un archivo local (perfecto para dev).
# En producción (Render, Railway, etc) usá Postgres, ej:
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db
DATABASE_URL=sqlite:///./personas.db

# --- Carpeta donde se guardan las fotos subidas ---
UPLOAD_DIR=uploads

# --- Auth / JWT ---
SECRET_KEY=cambia-esta-clave-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# En dev dejalo en "*". En producción poné el dominio real del frontend,
# separado por coma si hay más de uno:
# CORS_ORIGINS=https://cumple-makers.vercel.app,https://www.otro-dominio.com
CORS_ORIGINS=*
